PORT=3000

# PostgreSQL Database
DATABASE_URL="postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public"

# Redis Config
REDIS_URL="redis://localhost:6379"

# JWT Config
JWT_ACCESS_SECRET=your_jwt_access_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Order Config
# Delay before unpaid order is cancelled (in milliseconds). 900000 = 15 minutes.
ORDER_CANCEL_DELAY_MS=900000

# VNPay Config (Sandbox)
VNPAY_TMNCODE="YOUR_VNPAY_TMNCODE"
VNPAY_HASHSECRET="YOUR_VNPAY_HASHSECRET"
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_RETURN_URL="http://localhost:3000/orders/vnpay/return"
